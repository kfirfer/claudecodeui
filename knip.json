{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/main.jsx"
  ],
  "project": [
    "src/**/*.{js,jsx}",
    "server/**/*.js",
    "shared/**/*.js"
  ],
  "ignore": [
    "src/services/api/**",
    "**/*.d.ts",
    "eslint-custom-rules/**"
  ],
  "ignoreDependencies": [
    "sharp"
  ],
  "ignoreExportsUsedInFile": true
}
